<?xml version="1.0" encoding="utf-8"?>
<!-- Outfit: geometric sans (SIL OFL), weights 300-800. Global sans. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/outfit_300"
        android:fontStyle="normal"
        android:fontWeight="300"
        app:font="@font/outfit_300"
        app:fontStyle="normal"
        app:fontWeight="300" />
    <font
        android:font="@font/outfit_400"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/outfit_400"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        android:font="@font/outfit_500"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/outfit_500"
        app:fontStyle="normal"
        app:fontWeight="500" />
    <font
        android:font="@font/outfit_600"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:font="@font/outfit_600"
        app:fontStyle="normal"
        app:fontWeight="600" />
    <font
        android:font="@font/outfit_700"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/outfit_700"
        app:fontStyle="normal"
        app:fontWeight="700" />
    <font
        android:font="@font/outfit_800"
        android:fontStyle="normal"
        android:fontWeight="800"
        app:font="@font/outfit_800"
        app:fontStyle="normal"
        app:fontWeight="800" />
</font-family>
