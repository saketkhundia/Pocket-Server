<?xml version="1.0" encoding="utf-8"?>
<!-- Inter: Apple-SF-like geometric sans (SIL OFL). System font is the fallback. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/inter_400"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/inter_400"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        android:font="@font/inter_500"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/inter_500"
        app:fontStyle="normal"
        app:fontWeight="500" />
    <font
        android:font="@font/inter_600"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:font="@font/inter_600"
        app:fontStyle="normal"
        app:fontWeight="600" />
    <font
        android:font="@font/inter_700"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/inter_700"
        app:fontStyle="normal"
        app:fontWeight="700" />
</font-family>
